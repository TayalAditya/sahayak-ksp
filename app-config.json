{
  "services": {
    "appsail": [
      {
        "name": "sahayak-backend",
        "type": "appsail",
        "stack": "python3.11",
        "memory": 1024,
        "port": 8000,
        "dockerfile_path": "backend/Dockerfile",
        "env": {
          "LLM_PROVIDER": "catalyst-qwen",
          "ZOHO_DC": "in",
          "CATALYST_PROJECT_ID": "50328000000013024"
        }
      }
    ],
    "web_client": [
      {
        "name": "sahayak-frontend",
        "type": "slate",
        "build_command": "npm run build",
        "build_output_dir": "dist",
        "root_dir": "frontend"
      }
    ]
  }
}
