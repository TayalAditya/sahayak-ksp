# ============================================================================
# Sahayak — environment template.  Copy to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real secrets.
# ============================================================================

# Which LLM provider the NL->query engine uses:
#   mock          deterministic canned SQL (no creds needed — works right now)
#   ollama-qwen   local Qwen via Ollama (dev parity, needs Ollama installed)
#   catalyst-qwen Catalyst QuickML Qwen endpoint (production)
LLM_PROVIDER=catalyst-qwen

# ---- Zoho data center ------------------------------------------------------
# Indian accounts use "in"; others "com" | "eu" | "au" | "jp" | "ca".
# This sets accounts.zoho.<DC> and api-console.zoho.<DC>.
ZOHO_DC=in

# ---- Catalyst project ------------------------------------------------------
CATALYST_PROJECT_ID=
ZOHO_ORG_ID=                 # Catalyst org / ZAID — sent as a request header

# ---- OAuth (from Zoho API Console "Self Client") ---------------------------
# Scope needed for QuickML LLM serving: QuickML.deployment.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=          # generated once via tools/get_refresh_token.py

# ---- QuickML LLM serving endpoints (Generative AI > LLM Serving > Models) ---
QWEN_CODER_ENDPOINT=         # Qwen 2.5 - 7B Coder      -> NL->SQL generation
QWEN_INSTRUCT_ENDPOINT=      # Qwen 2.5 - 14B Instruct  -> summaries / chat / explanations
